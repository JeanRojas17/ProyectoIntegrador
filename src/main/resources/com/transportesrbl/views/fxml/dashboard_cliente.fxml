<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>

<BorderPane styleClass="main-container" stylesheets="@../css/dashboard_cliente.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.transportesrbl.controllers.DashboardClienteController">
    
    <left>
        <VBox styleClass="sidebar" prefWidth="250.0">
            <children>
                <VBox alignment="CENTER" spacing="10">
                    <padding>
                        <Insets top="30" right="0" bottom="30" left="0"/>
                    </padding>
                    <StackPane>
                        <Circle radius="40" fill="WHITE" stroke="#2c3e50" strokeWidth="2"/>
                        <Label text="RBL" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
                    </StackPane>
                    <Label text="Transportes RBL" styleClass="sidebar-title"/>
                    <Label text="Portal Clientes" styleClass="sidebar-subtitle"/>
                </VBox>

                <Separator style="-fx-background-color: #3e4f5f;"/>

                <VBox spacing="5" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets top="20" right="10" bottom="0" left="10"/>
                    </padding>
                    <Button fx:id="btnPedidos" onAction="#mostrarSeccionPedidos" text="MIS PEDIDOS" styleClass="menu-button-active" maxWidth="Infinity" />
                    <Button fx:id="btnResumen" onAction="#mostrarSeccionResumen" text="RESUMEN" styleClass="menu-button" maxWidth="Infinity" />
                    <Button fx:id="btnNovedades" onAction="#mostrarSeccionNovedades" text="NOVEDADES" styleClass="menu-button" maxWidth="Infinity" />
                </VBox>

                <VBox styleClass="user-profile">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15"/>
                    </padding>
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Circle radius="20" fill="#ecf0f1"/>
                        <VBox>
                            <Label fx:id="lblContacto" text="Cliente" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                            <Label fx:id="lblEmpresa" text="EMPRESA" style="-fx-text-fill: #bdc3c7; -fx-font-size: 10;"/>
                        </VBox>
                    </HBox>
                    <Button onAction="#handleLogout" text="Cerrar Sesión" styleClass="btn-logout" maxWidth="Infinity">
                        <VBox.margin>
                            <Insets top="10"/>
                        </VBox.margin>
                    </Button>
                </VBox>
            </children>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea">
            <VBox spacing="20" style="-fx-background-color: #f4f7f6;">
                <padding>
                    <Insets top="25" right="25" bottom="25" left="25" />
                </padding>

                <HBox alignment="CENTER_LEFT" styleClass="header-box">
                    <padding>
                        <Insets top="15" right="20" bottom="15" left="20"/>
                    </padding>
                    <VBox HBox.hgrow="ALWAYS">
                        <Label text="DASHBOARD" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
                        <Label text="RESUMEN DE CLIENTE"/>
                    </VBox>
                    <VBox alignment="CENTER" styleClass="date-box">
                        <Label text="Hoy"/>
                        <Label fx:id="lblFecha" text="17 May 2026" style="-fx-font-weight: bold;"/>
                    </VBox>
                </HBox>

                <!-- Hero Cards -->
                <FlowPane hgap="20" vgap="20" alignment="CENTER">
                    <children>
                        <VBox styleClass="stat-card">
                            <VBox alignment="CENTER" spacing="5">
                                <padding><Insets top="20" right="10" bottom="20" left="10"/></padding>
                                <Label fx:id="lblPaquetesCamino" text="0" styleClass="card-number"/>
                                <Label text="EN CAMINO" styleClass="card-label"/>
                            </VBox>
                        </VBox>
                        <VBox styleClass="stat-card">
                            <VBox alignment="CENTER" spacing="5">
                                <padding><Insets top="20" right="10" bottom="20" left="10"/></padding>
                                <Label fx:id="lblEntregadosExito" text="0" styleClass="card-number"/>
                                <Label text="ENTREGADOS" styleClass="card-label"/>
                            </VBox>
                        </VBox>
                        <VBox styleClass="stat-card">
                            <VBox alignment="CENTER" spacing="5">
                                <padding><Insets top="20" right="10" bottom="20" left="10"/></padding>
                                <HBox alignment="CENTER" spacing="5">
                                    <Label fx:id="lblVolumenTotal" text="0.0" styleClass="card-number"/>
                                    <Label text="m³" styleClass="card-label"/>
                                </HBox>
                                <Label text="VOLUMEN TOTAL" styleClass="card-label"/>
                            </VBox>
                        </VBox>
                    </children>
                </FlowPane>

                <!-- Active Orders -->
                <VBox spacing="15" VBox.vgrow="ALWAYS" styleClass="list-container">
                    <Label text="PEDIDOS RECIENTES" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                    
                    <ScrollPane fitToWidth="true" styleClass="transparent-scroll" VBox.vgrow="ALWAYS">
                        <VBox fx:id="containerPaquetes" spacing="10">
                            <padding>
                                <Insets right="10" />
                            </padding>
                        </VBox>
                    </ScrollPane>
                </VBox>
            </VBox>
        </StackPane>
    </center>

    <right>
        <VBox styleClass="notif-panel" prefWidth="300" spacing="20" style="-fx-background-color: white; -fx-border-color: #dcdde1; -fx-border-width: 0 0 0 1;">
            <padding>
                <Insets top="25" right="20" bottom="25" left="20" />
            </padding>
            <Label text="NOVEDADES" style="-fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #2c3e50;" />
            <Separator />
            <ScrollPane fitToWidth="true" styleClass="transparent-scroll" VBox.vgrow="ALWAYS">
                <VBox fx:id="containerNovedades" spacing="10" />
            </ScrollPane>
        </VBox>
    </right>

</BorderPane>

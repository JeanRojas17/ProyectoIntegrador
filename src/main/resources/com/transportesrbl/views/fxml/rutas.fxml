<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>

<VBox spacing="18" styleClass="main-container" stylesheets="@../css/rutas.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.transportesrbl.controllers.RutasController">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <HBox alignment="CENTER_LEFT" styleClass="header-box">
        <padding>
            <Insets top="15" right="18" bottom="15" left="18"/>
        </padding>
        <VBox HBox.hgrow="ALWAYS">
            <Label text="MONITOREO DE RUTAS" styleClass="header-title"/>
            <Label text="Trayectoria en tiempo real por producto y entrega" styleClass="header-subtitle"/>
        </VBox>
        <VBox alignment="CENTER_RIGHT" spacing="4">
            <Label fx:id="lblActualizacion" text="Ultima actualizacion: --:--:--" styleClass="update-text"/>
            <Button text="Refrescar" onAction="#handleRefrescar" styleClass="action-button"/>
        </VBox>
    </HBox>

    <HBox spacing="15">
        <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
            <Label fx:id="lblTotalRutas" text="0" styleClass="metric-number"/>
            <Label text="RUTAS TOTALES" styleClass="metric-label"/>
        </VBox>
        <VBox styleClass="metric-card-active" HBox.hgrow="ALWAYS">
            <Label fx:id="lblEnReparto" text="0" styleClass="metric-number-active"/>
            <Label text="EN REPARTO" styleClass="metric-label-active"/>
        </VBox>
        <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
            <Label fx:id="lblCompletadas" text="0" styleClass="metric-number"/>
            <Label text="COMPLETADAS" styleClass="metric-label"/>
        </VBox>
    </HBox>

    <HBox spacing="12" alignment="BOTTOM_LEFT" styleClass="filter-bar">
        <padding>
            <Insets top="14" right="14" bottom="14" left="14"/>
        </padding>
        <VBox spacing="5">
            <Label text="Producto" styleClass="filter-label"/>
            <TextField fx:id="txtProducto" promptText="Buscar producto" prefWidth="210"/>
        </VBox>
        <VBox spacing="5">
            <Label text="Estado" styleClass="filter-label"/>
            <ComboBox fx:id="cbEstado" prefWidth="155"/>
        </VBox>
        <VBox spacing="5">
            <Label text="Conductor" styleClass="filter-label"/>
            <ComboBox fx:id="cbConductor" prefWidth="210"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblEstadoMapa" text="0 rutas visibles en el mapa" styleClass="map-status"/>
    </HBox>

    <SplitPane dividerPositions="0.36" VBox.vgrow="ALWAYS" minHeight="430">
        <VBox spacing="10" styleClass="panel-list">
            <padding>
                <Insets top="14" right="14" bottom="14" left="14"/>
            </padding>
            <Label text="PRODUCTOS EN RUTA" styleClass="section-title"/>
            <TableView fx:id="tblRutas" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colProducto" text="Producto" prefWidth="155"/>
                    <TableColumn fx:id="colDestino" text="Destino" prefWidth="130"/>
                    <TableColumn fx:id="colConductor" text="Conductor" prefWidth="145"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="105"/>
                    <TableColumn fx:id="colProgreso" text="Avance" prefWidth="75"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>

        <StackPane styleClass="map-panel">
            <WebView fx:id="webMapa" minHeight="420"/>
        </StackPane>
    </SplitPane>
</VBox>